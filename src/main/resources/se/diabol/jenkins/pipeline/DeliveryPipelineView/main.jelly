<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler">
    <j:set var="fullscreen" value='${request.getParameter("fullscreen") == "true"}'/>
    <st:adjunct includes="se.diabol.jenkins.pipeline.DeliveryPipelineView.pipeline"/>
    <j:if test="${!fullscreen}">
        <j:set var="views" value="${it.owner.views}"/>
        <j:set var="currentView" value="${it}"/>
        <j:choose>
            <j:when test="${it.owner.class.name == 'hudson.model.MyViewsProperty'}">
                <st:include page="myViewTabs.jelly" it="${it.owner.myViewsTabBar}"/>
            </j:when>
            <j:otherwise>
                <st:include page="viewTabs.jelly" it="${it.owner.viewsTabBar}"/>
            </j:otherwise>
        </j:choose>
    </j:if>
    <!-- Everything the page script needs travels as data attributes; it never relies on page globals. -->
    <div class="dpp-view" data-view-url="${it.viewUrl}" data-root-url="${rootURL}"
         data-fullscreen="${fullscreen}"
         data-crumb-field="${h.getCrumbRequestField()}" data-crumb-value="${h.getCrumb(request)}">
        <div class="dpp-error" role="alert" hidden="hidden"></div>
        <div class="dpp-message"><span class="dpp-spinner" aria-label="Loading"></span></div>
        <div class="dpp-columns"></div>
    </div>
</j:jelly>
