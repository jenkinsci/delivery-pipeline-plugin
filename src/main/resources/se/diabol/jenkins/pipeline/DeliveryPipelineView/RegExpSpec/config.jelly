<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
    <f:entry title="${%Regular expression}" field="regexp">
        <f:textbox/>
    </f:entry>
    <f:entry title="${%Show upstream}" field="showUpstream">
        <f:checkbox/>
    </f:entry>
    <f:entry>
        <f:repeatableDeleteButton/>
    </f:entry>
</j:jelly>
