<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler">
    <st:contentType value="text/html;charset=UTF-8"/>
    <j:new var="h" className="hudson.Functions"/>
    ${h.initPageVariables(context)}
    <j:choose>
        <j:when test='${request.getParameter("fullscreen") == "true"}'>
            <!-- The wall board page: no Jenkins chrome, dark, and nothing but the pipelines. -->
            <html lang="en">
                <head>
                    <meta charset="UTF-8"/>
                    <meta name="viewport" content="width=device-width, initial-scale=1"/>
                    <title>${it.viewName}</title>
                    <link rel="shortcut icon" href="${resURL}/favicon.ico" type="image/vnd.microsoft.icon"/>
                    <st:adjunct includes="se.diabol.jenkins.pipeline.DeliveryPipelineView.pipeline"/>
                </head>
                <body class="dpp-fullscreen">
                    <st:include page="main.jelly"/>
                </body>
            </html>
        </j:when>
        <j:otherwise>
            <st:include page="index.jelly" class="hudson.model.View"/>
        </j:otherwise>
    </j:choose>
</j:jelly>
